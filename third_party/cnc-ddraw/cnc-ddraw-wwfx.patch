+/* War Wind "Modern Graphics": the lit frame through wwfx, then the plain path's state restored. */
+static BOOL d3d9_render_fx(int tex_index, int pal_index)
+{
+    WWFX_TARGET target;
+    target.index_tex = g_d3d9.surface_tex[tex_index];
+    target.palette_tex = g_d3d9.palette_tex[pal_index];
+    target.tex_width = g_d3d9.tex_width;
+    target.tex_height = g_d3d9.tex_height;
+    target.viewport.X = g_ddraw.render.viewport.x;
+    target.viewport.Y = g_ddraw.render.viewport.y;
+    target.viewport.Width = g_ddraw.render.viewport.width;
+    target.viewport.Height = g_ddraw.render.viewport.height;
+    target.viewport.MinZ = 0.0f;
+    target.viewport.MaxZ = 1.0f;
+    target.time = timeGetTime() / 1000.0f;
+
+    D3DVIEWPORT9 full;
+    IDirect3DDevice9_GetViewport(g_d3d9.device, &full);
+
+    BOOL drawn = wwfx_gpu_render(&target);
+
+    IDirect3DDevice9_SetViewport(g_d3d9.device, &full);
+    d3d9_set_states();
+    IDirect3DDevice9_SetTexture(g_d3d9.device, 0, (IDirect3DBaseTexture9*)g_d3d9.surface_tex[tex_index]);
+    IDirect3DDevice9_SetTexture(g_d3d9.device, 1, (IDirect3DBaseTexture9*)g_d3d9.palette_tex[pal_index]);
+
+    return drawn;
+}
