diff --git a/inc/wwfx.h b/inc/wwfx.h
new file mode 100644
index 0000000..42368ca
--- /dev/null
+++ b/inc/wwfx.h
@@ -0,0 +1,125 @@
+#ifndef WWFX_H
+#define WWFX_H
+
+/*
+ * War Wind "Modern Graphics": a post-process for 8-bit paletted frames.
+ *
+ * The game side (the War Wind HD proxy) submits, for every flipped frame, per-pixel side planes
+ * that describe what each palette index on screen is (terrain, unit, building, UI ...) and how
+ * much projected shadow covers it, plus a list of point lights. The D3D9 renderer latches them
+ * together with the frame at Flip and replaces its single palette pass by a lighting chain.
+ * Frames without a submission render exactly as before.
+ */
+
+#include <windows.h>
+
+#define WWFX_VERSION 3
+
+/* Mask plane values: what a screen pixel shows. */
+enum
+{
+    WWFX_CLASS_NONE = 0,      /* UI, text, cursor: shown untouched */
+    WWFX_CLASS_TERRAIN = 1,   /* ground; the shader finds water on it by its palette colours */
+    WWFX_CLASS_UNIT = 3,
+    WWFX_CLASS_BUILDING = 4,
+    WWFX_CLASS_DOODAD = 5,    /* trees, rocks, walls, resources */
+    WWFX_CLASS_EFFECT = 6,    /* projectiles, explosions, spells */
+};
+
+#define WWFX_MAX_LIGHTS 256
+
+typedef struct WWFX_LIGHT
+{
+    float x, y;               /* frame pixels */
+    float radius;             /* frame pixels */
+    float r, g, b;            /* linear colour times intensity */
+    float flicker;            /* 0 = steady, 1 = full fire flicker */
+    float seed;               /* decorrelates flicker between lights */
+} WWFX_LIGHT;
+
+typedef struct WWFX_PARAMS
+{
+    float shadow_opacity;     /* 0..1 darkening under full shadow */
+    float shadow_softness;    /* blur radius, frame pixels */
+    float ao_strength;        /* 0..1 contact darkening around objects */
+    float ao_radius;          /* frame pixels */
+    float ambient;            /* scene brightness without lights, 1 = original */
+    float light_intensity;    /* point lights and emissive glow */
+    float emissive_glow;      /* glow radius, frame pixels */
+    float bloom;              /* extra additive glow on emissive pixels */
+    float contrast;           /* 1 = unchanged */
+    float saturation;         /* 1 = unchanged */
+    float vignette;           /* 0 = off */
+    float sharpen;            /* 0 = off */
+    float shadow_tint[3];     /* colour multiplied into shadowed ground */
+    float fog_opacity;        /* darkening of terrain and things outside the player's sight */
+    float water_waves;        /* wave distortion of water, frame pixels (0 = off) */
+    float water_glints;       /* sun sparkles and caustics on water, 0..1+ */
+    float water_foam;         /* foam along shores, 0..1+ */
+} WWFX_PARAMS;
+
+typedef struct WWFX_SETUP
+{
+    int version;              /* WWFX_VERSION */
+    char shader_path[MAX_PATH];
+    WWFX_PARAMS params;
+    /* Per palette index: rgb tint and strength (a) of light the colour emits; 0 = none. */
+    unsigned char emissive[256][4];
+} WWFX_SETUP;
+
+typedef struct WWFX_FRAME
+{
+    int width, height;        /* must match the primary surface */
+    const unsigned char* mask;    /* WWFX_CLASS_* per pixel */
+    int mask_pitch;
+    const unsigned char* shadow;  /* projected shadow coverage 0..255 per pixel */
+    int shadow_pitch;
+    const unsigned char* fog;     /* fog-of-war coverage 0..255 per pixel */
+    int fog_pitch;
+    const WWFX_LIGHT* lights;
+    int light_count;
+    float world_x, world_y;   /* world pixel shown at frame (0, 0): anchors animated water to the map */
+} WWFX_FRAME;
+
+/* Exports (stdcall). */
+typedef BOOL(WINAPI* WWFX_SETUP_PROC)(const WWFX_SETUP* setup);
+typedef BOOL(WINAPI* WWFX_SUBMIT_PROC)(const WWFX_FRAME* frame);
+typedef BOOL(WINAPI* WWFX_AVAILABLE_PROC)(void);
+typedef BOOL(WINAPI* WWFX_SCREENSHOT_PROC)(const char* png_path);
+
+#ifdef WWFX_INTERNAL
+#include <d3d9.h>
+
+/* Staging (game thread) and latching (inside Flip, under the ddraw lock). */
+void wwfx_latch(void);
+void wwfx_invalidate(void);
+
+/* GPU side, independent of cnc-ddraw's globals so tools can drive it. */
+typedef struct WWFX_TARGET
+{
+    IDirect3DTexture9* index_tex;     /* L8, frame in the top-left corner */
+    IDirect3DTexture9* palette_tex;   /* 256x1 X8R8G8B8 */
+    int tex_width, tex_height;        /* size of index_tex */
+    D3DVIEWPORT9 viewport;            /* where the frame lands on the render target */
+    float time;                       /* seconds, drives flicker and water */
+} WWFX_TARGET;
+
+BOOL wwfx_gpu_create(IDirect3DDevice9* device, int width, int height, int tex_width, int tex_height);
+void wwfx_gpu_release_default(void);       /* before IDirect3DDevice9::Reset */
+BOOL wwfx_gpu_restore_default(void);       /* after Reset */
+void wwfx_gpu_release(void);
+BOOL wwfx_gpu_ready(void);
+/* Uploads the latched planes when they changed; call under the lock guarding them. */
+BOOL wwfx_gpu_upload(void);
+/* Draws the lit frame into the current render target; FALSE = draw the plain frame instead. */
+BOOL wwfx_gpu_render(const WWFX_TARGET* target);
+/* Saves the render target (call before Present) if a screenshot was requested. */
+BOOL wwfx_request_screenshot(const char* png_path);
+void wwfx_gpu_capture(IDirect3DSurface9* back_buffer);
+
+/* Tool entry points (fxpreview): same as the exports, callable directly. */
+BOOL wwfx_setup(const WWFX_SETUP* setup);
+BOOL wwfx_submit(const WWFX_FRAME* frame);
+#endif
+
+#endif
