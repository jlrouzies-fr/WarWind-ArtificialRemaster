+/* Image shown around a boxed game picture instead of black (backdrop=<png>, relative to the game
+   folder). Decoded once; returns top-down 0x00RRGGBB pixels, or NULL when none is configured. */
+const unsigned int* util_get_backdrop(unsigned int* width, unsigned int* height)
+{
+    static unsigned int* pixels;
+    static unsigned int w, h;
+    static BOOL tried;
+
+    if (!tried && g_config.backdrop[0])
+    {
+        tried = TRUE;
+
+        char path[MAX_PATH];
+
+        if (strchr(g_config.backdrop, ':') || g_config.backdrop[0] == '\\')
+            _snprintf(path, sizeof(path) - 1, "%s", g_config.backdrop);
+        else
+            _snprintf(path, sizeof(path) - 1, "%s%s", g_config.game_path, g_config.backdrop);
+
+        path[sizeof(path) - 1] = 0;
+
+        unsigned char* rgba = NULL;
+
+        if (lodepng_decode32_file(&rgba, &w, &h, path) == 0)
+        {
+            pixels = (unsigned int*)rgba;
+
+            for (size_t i = 0; i < (size_t)w * h; i++, rgba += 4)
+                pixels[i] = (rgba[0] << 16) | (rgba[1] << 8) | rgba[2];
+        }
+        else
+        {
+            TRACE("backdrop: cannot load %s\n", path);
+            free(rgba);
+        }
+    }
+
+    *width = w;
+    *height = h;
+    return pixels;
+}
